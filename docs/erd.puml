@startuml ERD — Система управления меню ресторана микросервисами

' ──────────────────────────────────────────────
'  Стили
' ──────────────────────────────────────────────
skinparam linetype ortho
skinparam roundcorner 8
skinparam shadowing false
skinparam DefaultFontName "Segoe UI"
skinparam DefaultFontSize 12

skinparam entity {
    BackgroundColor<<menu>>      #E8F4FD
    BorderColor<<menu>>          #2980B9
    HeaderBackgroundColor<<menu>> #2980B9
    FontColor<<menu>>            white

    BackgroundColor<<warehouse>> #E9F7EF
    BorderColor<<warehouse>>     #27AE60
    HeaderBackgroundColor<<warehouse>> #27AE60
    FontColor<<warehouse>>       white

    BackgroundColor<<order>>     #FEF9E7
    BorderColor<<order>>         #F39C12
    HeaderBackgroundColor<<order>> #F39C12
    FontColor<<order>>           white
}

skinparam note {
    BackgroundColor #FDFEFE
    BorderColor     #BDC3C7
}

' ══════════════════════════════════════════════
'  БД: menu_db
' ══════════════════════════════════════════════
package "menu_db" #E8F4FD {

    entity "категории" <<menu>> {
        * id            : UUID         <<PK>>
        --
        * name          : VARCHAR(255) <<UNIQUE>>
          description   : TEXT
        * is_active      : BOOLEAN      = true
        * created_at     : TIMESTAMPTZ
        * updated_at     : TIMESTAMPTZ
    }

    entity "блюда" <<menu>> {
        * id            : UUID         <<PK>>
        --
          category_id   : UUID         <<FK → categories.id>>
        * name          : VARCHAR(255)
          description   : TEXT
        * price         : NUMERIC(10,2)
        * is_available   : BOOLEAN      = true
          image_url     : TEXT
        * created_at     : TIMESTAMPTZ
        * updated_at     : TIMESTAMPTZ
    }

    entity "состав_блюда" <<menu>> {
        * id           : UUID          <<PK>>
        --
        * dish_id      : UUID          <<FK → dishes.id CASCADE>>
        * product_id   : UUID          <<ref: products.id (кросс-сервис)>>
        * product_name : VARCHAR(255)  <<снимок>>
        * quantity     : NUMERIC(10,3)
        * unit         : VARCHAR(50)
    }

    entity "история_цен" <<menu>> {
        * id         : UUID          <<PK>>
        --
        * dish_id    : UUID          <<FK → dishes.id>>
        * old_price  : NUMERIC(10,2)
        * new_price  : NUMERIC(10,2)
        * changed_at : TIMESTAMPTZ
    }

    категории  ||--o{ блюда         : "содержит"
    блюда      ||--o{ история_цен  : "отслеживает"
    блюда      ||--o{ состав_блюда : "имеет рецепт"
}

' ══════════════════════════════════════════════
'  БД: warehouse_db
' ══════════════════════════════════════════════
package "warehouse_db" #E9F7EF {

    entity "продукты" <<warehouse>> {
        * id                : UUID          <<PK>>
        --
        * name              : VARCHAR(255)  <<UNIQUE>>
        * unit              : VARCHAR(50)
        * current_stock     : NUMERIC(12,3) = 0
        * min_stock_level   : NUMERIC(12,3) = 0
          cost_price        : NUMERIC(10,2)
        * created_at         : TIMESTAMPTZ
        * updated_at         : TIMESTAMPTZ
    }

    entity "движения_запаса" <<warehouse>> {
        * id            : UUID          <<PK>>
        --
        * product_id    : UUID          <<FK → products.id>>
        * quantity      : NUMERIC(12,3)
        * movement_type : ENUM          <<INCOMING|OUTGOING|WRITE_OFF>>
          reason        : TEXT
          order_id      : UUID          <<ref: orders.id (кросс-сервис)>>
        * created_at     : TIMESTAMPTZ
    }

    продукты ||--o{ движения_запаса : "записывает"
}

' ══════════════════════════════════════════════
'  БД: order_db
' ══════════════════════════════════════════════
package "order_db" #FEF9E7 {

    entity "заказы" <<order>> {
        * id            : UUID          <<PK>>
        --
          table_number  : INTEGER
          customer_name : VARCHAR(255)
        * status        : ENUM          <<CREATED|IN_PROGRESS|READY|CLOSED|CANCELLED>>
          notes         : TEXT
        * total_amount   : NUMERIC(10,2) = 0
        * created_at     : TIMESTAMPTZ
        * updated_at     : TIMESTAMPTZ
          taken_at      : TIMESTAMPTZ
          closed_at     : TIMESTAMPTZ
    }

    entity "позиции_заказа" <<order>> {
        * id             : UUID          <<PK>>
        --
        * order_id       : UUID          <<FK → orders.id>>
        * dish_id        : UUID          <<ref: dishes.id (кросс-сервис)>>
        * dish_name      : VARCHAR(255)  <<снимок>>
        * quantity       : INTEGER
        * price_at_order : NUMERIC(10,2) <<снимок>>
          notes          : TEXT
    }

    entity "ингредиенты_заказа" <<order>> {
        * id           : UUID          <<PK>>
        --
        * order_id     : UUID          <<FK → orders.id CASCADE>>
        * product_id   : UUID          <<ref: products.id (кросс-сервис)>>
        * product_name : VARCHAR(255)  <<снимок>>
        * unit         : VARCHAR(50)   <<снимок>>
        * quantity     : NUMERIC(10,3) <<агрегировано по позициям>>
    }

    заказы ||--o{ позиции_заказа     : "содержит"
    заказы ||--o{ ингредиенты_заказа : "резервирует"
}

' ══════════════════════════════════════════════
'  БД: auth_db
' ══════════════════════════════════════════════

skinparam entity {
    BackgroundColor<<auth>> #F5EEF8
    BorderColor<<auth>>     #8E44AD
    HeaderBackgroundColor<<auth>> #8E44AD
    FontColor<<auth>>       white
}

package "auth_db" #F5EEF8 {

    entity "разрешения" <<auth>> {
        * code          : VARCHAR(100) <<PK>>
        --
        * description   : VARCHAR(255)
        * group         : VARCHAR(100)
    }

    entity "роли" <<auth>> {
        * id            : UUID         <<PK>>
        --
        * name          : VARCHAR(100) <<UNIQUE>>
          description   : TEXT
        * is_system      : BOOLEAN      = false
        * created_at     : TIMESTAMPTZ
    }

    entity "роли_разрешения" <<auth>> {
        * role_id           : UUID         <<PK, FK → roles.id CASCADE>>
        * permission_code   : VARCHAR(100) <<PK, FK → permissions.code CASCADE>>
    }

    entity "пользователи" <<auth>> {
        * id               : UUID         <<PK>>
        --
          role_id          : UUID         <<FK → roles.id SET NULL>>
        * email            : VARCHAR(255) <<UNIQUE>>
        * full_name        : VARCHAR(255)
        * hashed_password  : VARCHAR(255)
        * is_active         : BOOLEAN      = true
        * created_at        : TIMESTAMPTZ
        * updated_at        : TIMESTAMPTZ
    }

    роли          ||--o{ роли_разрешения  : "содержит"
    разрешения    ||--o{ роли_разрешения  : "назначено в"
    роли          ||--o{ пользователи     : "назначена"
}

' ══════════════════════════════════════════════
'  Кросс-сервисные логические ссылки (пунктир)
' ══════════════════════════════════════════════
блюда            ....> позиции_заказа     : "dish_id (HTTP ссылка)"
состав_блюда     ....> продукты           : "product_id (HTTP ссылка)"
ингредиенты_заказа ....> продукты         : "product_id → списание OUTGOING"

' ══════════════════════════════════════════════
'  Легенда
' ══════════════════════════════════════════════
legend right
  |= Символ |= Значение              |
  |  *       | NOT NULL              |
  |  <<PK>>  | Первичный ключ (UUID)    |
  |  <<FK>>  | Внешний ключ           |
  |  ....>   | Кросс-сервисная HTTP ссылка|
  |  = val   | Значение по умолчанию         |
endlegend

@enduml
