@startuml C4 Уровень 2 — Диаграмма контейнера

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
LAYOUT_LEFT_RIGHT()

title C4 Модель — Уровень 2: Диаграмма контейнера\nСистема управления меню ресторана микросервисами

AddElementTag("fastapi", $bgColor="#2980B9", $fontColor="white",  $borderColor="#1A5276", $sprite="python")
AddElementTag("flask",   $bgColor="#F39C12", $fontColor="white",  $borderColor="#B7770D", $sprite="python")
AddElementTag("pg",      $bgColor="#336791", $fontColor="white",  $borderColor="#1A3A54")

' ──────────────────────────────────────────────
'  Актеры
' ──────────────────────────────────────────────
Person(manager, "Менеджер ресторана", "Управляет меню и запасом")
Person(staff,   "Официант / Повар",      "Создает и обрабатывает заказы")

' ──────────────────────────────────────────────
'  Граница системы
' ──────────────────────────────────────────────
System_Boundary(rms, "Система управления меню ресторана  —  docker compose") {

    ' ── menu-service ──────────────────────────
    Container_Boundary(ms_bound, "menu-service  :8001") {
        Container(menu_api, "Menu API",
            "Python 3.12 / FastAPI\nasync SQLAlchemy 2.0 / Pydantic v2",
            "Выдает REST API для категорий,\nблюд, цен, информации о питательности", $tags="fastapi")

        ContainerDb(menu_db, "menu_db",
            "PostgreSQL 16",
            "таблицы: categories, dishes,\nprice_history", $tags="pg")
    }

    ' ── warehouse-service ─────────────────────
    Container_Boundary(ws_bound, "warehouse-service  :8002") {
        Container(warehouse_api, "Warehouse API",
            "Python 3.12 / FastAPI\nasync SQLAlchemy 2.0 / Pydantic v2",
            "Управление запасом: продукты,\nдвижения, уведомления низкого запаса", $tags="fastapi")

        ContainerDb(warehouse_db, "warehouse_db",
            "PostgreSQL 16",
            "таблицы: products,\nstock_movements", $tags="pg")
    }

    ' ── order-service ─────────────────────────
    Container_Boundary(os_bound, "order-service  :8003") {
        Container(order_api, "Order API",
            "Python 3.12 / Flask 3.0\nSQLAlchemy / Pydantic v2",
            "Жизненный цикл заказа:\nСОЗДАН→В_ПРОЦЕССЕ→ГОТОВ→ЗАКРЫТ", $tags="flask")

        ContainerDb(order_db, "order_db",
            "PostgreSQL 16",
            "таблицы: orders,\norder_items", $tags="pg")
    }
}

' ──────────────────────────────────────────────
'  Отношения — актеры → контейнеры
' ──────────────────────────────────────────────
Rel(manager, menu_api,      "CRUD категорий, блюд,\nцен, питательности",  "HTTPS / JSON")
Rel(manager, warehouse_api, "CRUD продуктов,\nрегулирование запаса",                 "HTTPS / JSON")
Rel(staff,   order_api,     "Создание / взяток / закрытие\nзаказов",                "HTTPS / JSON")

' ──────────────────────────────────────────────
'  Отношения — APIs → БД
' ──────────────────────────────────────────────
Rel(menu_api,      menu_db,      "чтение / запись", "asyncpg\nSQLAlchemy async")
Rel(warehouse_api, warehouse_db, "чтение / запись", "asyncpg\nSQLAlchemy async")
Rel(order_api,     order_db,     "чтение / запись", "psycopg2\nSQLAlchemy sync")

' ──────────────────────────────────────────────
'  Отношения — HTTP между сервисами
' ──────────────────────────────────────────────
Rel(order_api, menu_api,      "GET /api/v1/dishes/{id}\nПроверить блюдо и получить цену",   "HTTP / JSON\nhttpx sync")
Rel(order_api, warehouse_api, "POST /api/v1/products/consume\nСписать запас при закрытии",  "HTTP / JSON\nhttpx sync")

' ──────────────────────────────────────────────
'  Заметки
' ──────────────────────────────────────────────
note right of order_api
  Уведомление склада
  **fire-and-forget** (по возможности).
  Ошибки логируются; запас
  сверяется асинхронно.
end note

note right of menu_api
  Каждый сервис владеет своей БД.
  Нет общей схемы, нет прямых
  кросс-сервисных запросов БД.
end note

@enduml
