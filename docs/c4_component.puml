@startuml C4 Level 3 — Component Diagram (menu-service)

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

title C4 Model — Level 3: Component Diagram\nmenu-service (FastAPI)

AddElementTag("router",  $bgColor="#5DADE2", $fontColor="white", $borderColor="#1A5276")
AddElementTag("service", $bgColor="#48C9B0", $fontColor="white", $borderColor="#117A65")
AddElementTag("repo",    $bgColor="#F1948A", $fontColor="white", $borderColor="#922B21")
AddElementTag("schema",  $bgColor="#F7DC6F", $fontColor="#333",  $borderColor="#B7950B")
AddElementTag("model",   $bgColor="#BB8FCE", $fontColor="white", $borderColor="#6C3483")

Person(client, "API Client", "Any HTTP client:\ncurl, Postman, frontend, other service")
ContainerDb(menu_db, "menu_db", "PostgreSQL 16", "categories, dishes, price_history")

Container_Boundary(menu_api, "menu-service  :8001  (FastAPI)") {

    ' ── Routers / Controllers ─────────────────
    Component(cat_router,  "CategoriesRouter",   "FastAPI APIRouter\nPATH: /api/v1/categories",
              "Create, read, update, delete\ncategories; active-only filter", $tags="router")

    Component(dish_router, "DishesRouter",       "FastAPI APIRouter\nPATH: /api/v1/dishes",
              "Create, read, update, delete dishes;\nfilter by category/availability;\nprice update + price history", $tags="router")

    ' ── Services / Business Logic ─────────────
    Component(cat_svc,  "CategoryService",  "Python class",
              "Name uniqueness check;\ncreate, list, update, delete", $tags="service")

    Component(dish_svc, "DishService",      "Python class",
              "Category existence check;\ncreate, list, update, delete;\nprice snapshot logic", $tags="service")

    ' ── Repositories / Data Access ────────────
    Component(cat_repo,  "CategoryRepository",  "SQLAlchemy async",
              "get_by_id, get_by_name,\nlist_all, create, update, delete", $tags="repo")

    Component(dish_repo, "DishRepository",      "SQLAlchemy async",
              "CRUD + update_price\n(writes PriceHistory record),\nget_price_history", $tags="repo")

    ' ── Pydantic Schemas ──────────────────────
    Component(cat_schema,  "CategoryCreate / Update / Response", "Pydantic v2 BaseModel",
              "Validates: name strip, min/max length,\nis_active coercion", $tags="schema")

    Component(dish_schema, "DishCreate / Update / PriceUpdate", "Pydantic v2 BaseModel",
              "Validates: price > 0, calories 0-10000,\nnutrition decimals, at-least-one-field", $tags="schema")

    ' ── ORM Models ────────────────────────────
    Component(cat_model,   "Category",     "SQLAlchemy Mapped model",
              "id, name, description,\nis_active, timestamps", $tags="model")

    Component(dish_model,  "Dish",         "SQLAlchemy Mapped model",
              "id, category_id, name, price,\ncalories, proteins, fats, carbs,\nweight_grams, is_available", $tags="model")

    Component(price_model, "PriceHistory", "SQLAlchemy Mapped model",
              "id, dish_id, old_price,\nnew_price, changed_at", $tags="model")
}

' ── Request flow ──────────────────────────────
Rel(client, cat_router,  "HTTP request",  "JSON")
Rel(client, dish_router, "HTTP request",  "JSON")

Rel(cat_router,  cat_schema,  "validates input via")
Rel(dish_router, dish_schema, "validates input via")

Rel(cat_router,  cat_svc,  "delegates to")
Rel(dish_router, dish_svc, "delegates to")

Rel(cat_svc,  cat_repo,  "calls")
Rel(dish_svc, dish_repo, "calls")
Rel(dish_svc, cat_repo,  "checks category existence")

Rel(cat_repo,  cat_model,   "maps to/from")
Rel(dish_repo, dish_model,  "maps to/from")
Rel(dish_repo, price_model, "writes on price change")

Rel(cat_model,   menu_db, "persisted in", "asyncpg")
Rel(dish_model,  menu_db, "persisted in", "asyncpg")
Rel(price_model, menu_db, "persisted in", "asyncpg")

@enduml
