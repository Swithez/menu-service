@startuml C4 Level 1 — System Context

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

title C4 Model — Level 1: System Context\nRestaurant Menu Microservice System

' ──────────────────────────────────────────────
'  Persons
' ──────────────────────────────────────────────
Person(manager,   "Restaurant Manager",  "Manages the menu, prices,\ncategories and warehouse stock")
Person(waiter,    "Waiter / Cashier",    "Creates orders, takes them\ninto work and closes them")
Person(chef,      "Kitchen Chef",        "Sees orders in progress\nand marks them as READY")
Person(developer, "Developer / DevOps",  "Deploys, monitors and\nmaintains the system")

' ──────────────────────────────────────────────
'  System boundary
' ──────────────────────────────────────────────
System_Boundary(rms, "Restaurant Menu System") {
    System(menu_sys,      "Menu Service",      "Manages categories, dishes,\nprices and nutritional info")
    System(warehouse_sys, "Warehouse Service", "Tracks ingredient stock,\nmovements and low-stock alerts")
    System(order_sys,     "Order Service",     "Handles full order lifecycle:\ncreate → take → ready → close")
}

' ──────────────────────────────────────────────
'  External systems (future)
' ──────────────────────────────────────────────
System_Ext(pos,        "POS Terminal",       "Point-of-sale hardware\n(future integration)")
System_Ext(supplier,   "Supplier Portal",    "Automatic stock replenishment\n(future integration)")
System_Ext(analytics,  "Analytics Platform", "Sales and waste reports\n(future integration)")

' ──────────────────────────────────────────────
'  Relationships — people → system
' ──────────────────────────────────────────────
Rel(manager,   menu_sys,      "Manages dishes, prices, categories", "REST / JSON")
Rel(manager,   warehouse_sys, "Manages products, adjusts stock",    "REST / JSON")
Rel(waiter,    order_sys,     "Creates and closes orders",          "REST / JSON")
Rel(chef,      order_sys,     "Takes orders into work, marks ready","REST / JSON")
Rel(developer, rms,           "Deploys & monitors",                 "Docker / SSH")

' ──────────────────────────────────────────────
'  Relationships — system → system
' ──────────────────────────────────────────────
Rel(order_sys,     menu_sys,      "Fetches dish details\n& validates availability", "HTTP GET")
Rel(order_sys,     warehouse_sys, "Triggers stock deduction\non order close",        "HTTP POST")

' ──────────────────────────────────────────────
'  Relationships — external
' ──────────────────────────────────────────────
Rel_Back(pos,      order_sys,     "Receives order totals",      "REST (planned)")
Rel_Back(supplier, warehouse_sys, "Pushes incoming deliveries", "Webhook (planned)")
Rel_Back(analytics,rms,           "Reads aggregated data",      "Read replica (planned)")

@enduml
