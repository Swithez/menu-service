@startuml C4 Уровень 1 — Контекст системы

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

title C4 Модель — Уровень 1: Контекст системы\nСистема управления меню ресторана микросервисами

' ──────────────────────────────────────────────
'  Люди
' ──────────────────────────────────────────────
Person(manager,   "Менеджер ресторана",  "Управляет меню, ценами,\nкатегориями и запасом на складе")
Person(waiter,    "Официант / Кассир",    "Создает заказы, берет их\nв работу и закрывает их")
Person(chef,      "Повар кухни",        "Видит заказы в процессе\nи отмечает их как ГОТОВЫ")
Person(developer, "Разработчик / DevOps",  "Развертывает, контролирует и\nподдерживает систему")

' ──────────────────────────────────────────────
'  Граница системы
' ──────────────────────────────────────────────
System_Boundary(rms, "Система управления меню ресторана") {
    System(menu_sys,      "Сервис меню",      "Управляет категориями, блюдами,\nценами и информацией о питательности")
    System(warehouse_sys, "Сервис склада", "Отслеживает запас ингредиентов,\nдвижения и уведомления низкого запаса")
    System(order_sys,     "Сервис заказов",     "Обрабатывает полный жизненный цикл заказа:\nсоздание → взяток → готовность → закрытие")
}

' ──────────────────────────────────────────────
'  Внешние системы (будущее)
' ──────────────────────────────────────────────
System_Ext(pos,        "POS-терминал",       "Оборудование для продаж\n(будущая интеграция)")
System_Ext(supplier,   "Портал поставщика",    "Автоматическое пополнение запаса\n(будущая интеграция)")
System_Ext(analytics,  "Платформа аналитики", "Отчеты по продажам и потерям\n(будущая интеграция)")

' ──────────────────────────────────────────────
'  Отношения — люди → система
' ──────────────────────────────────────────────
Rel(manager,   menu_sys,      "Управляет блюдами, ценами, категориями", "REST / JSON")
Rel(manager,   warehouse_sys, "Управляет продуктами, регулирует запас",    "REST / JSON")
Rel(waiter,    order_sys,     "Создает и закрывает заказы",          "REST / JSON")
Rel(chef,      order_sys,     "Берет заказы в работу, отмечает готовыми","REST / JSON")
Rel(developer, rms,           "Развертывает и контролирует",                 "Docker / SSH")

' ──────────────────────────────────────────────
'  Отношения — система → система
' ──────────────────────────────────────────────
Rel(order_sys,     menu_sys,      "Получает детали блюда\nи проверяет доступность", "HTTP GET")
Rel(order_sys,     warehouse_sys, "Запускает списание запаса\nпри закрытии заказа",        "HTTP POST")

' ──────────────────────────────────────────────
'  Отношения — внешние
' ──────────────────────────────────────────────
Rel_Back(pos,      order_sys,     "Получает суммы заказов",      "REST (планируется)")
Rel_Back(supplier, warehouse_sys, "Отправляет входящие доставки", "Webhook (планируется)")
Rel_Back(analytics,rms,           "Читает агрегированные данные",      "Read replica (планируется)")

@enduml
