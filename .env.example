# ─── Databases ──────────────────────────────────────────────────────────────────
MENU_DATABASE_URL=postgresql+asyncpg://menu_user:menu_password@localhost:5432/menu_db
WAREHOUSE_DATABASE_URL=postgresql+asyncpg://warehouse_user:warehouse_password@localhost:5433/warehouse_db
ORDER_DATABASE_URL=postgresql://order_user:order_password@localhost:5434/order_db
AUTH_DATABASE_URL=postgresql+asyncpg://auth_user:auth_password@localhost:5435/auth_db

# ─── Auth / JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Initial admin account (created on first start if no users exist) ────────────
ADMIN_EMAIL=admin@restaurant.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Администратор

# ─── Web UI ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me
